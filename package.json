{
  "name": "tabletop-games",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run generate:rules-catalogs",
    "dev": "next dev",
    "prebuild": "npm run generate:rules-catalogs",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit --incremental false",
    "generate:rules-catalogs": "node --import tsx scripts/generate-rule-catalogs.ts",
    "publish:rules-catalogs": "node --import tsx scripts/publish-rule-catalogs.ts",
    "audit:structure": "node --import tsx tooling/audit-project-structure.ts",
    "audit:disciplines": "node --import tsx src/games/vampires/scripts/audit-discipline-rules.ts",
    "validate:disciplines": "node --import tsx src/games/vampires/scripts/validate-discipline-mechanics.ts",
    "test:disciplines": "node --import tsx src/games/vampires/scripts/test-discipline-engine.ts",
    "test:vtm-parity": "node --import tsx src/games/vampires/scripts/test-vtm-legacy-parity.ts",
    "test:master-console": "node --import tsx src/games/vampires/scripts/test-master-console.ts",
    "test:rules-chat": "node --import tsx src/games/vampires/scripts/test-rules-chat-search.ts",
    "test:chronicle-library": "node --import tsx src/games/vampires/scripts/test-chronicle-library.ts",
    "test:pathfinder2-builder": "node --import tsx src/games/pathfinder2/sheet/rules/test-pathfinder2-builder.ts",
    "test:pathfinder2-data": "node --import tsx src/games/pathfinder2/sheet/rules/test-pathfinder2-data.ts",
    "test:pathfinder2-equipment": "node --import tsx src/games/pathfinder2/sheet/rules/equipment/test-pathfinder2-equipment.ts",
    "test:pathfinder2-spells": "node --import tsx src/games/pathfinder2/sheet/rules/spells/test-pathfinder2-spells.ts",
    "test:pathfinder2-progression": "node --import tsx src/games/pathfinder2/sheet/rules/progression/test-pathfinder2-progression.ts",
    "test:pathfinder2-builder:e2e": "node --import tsx src/games/pathfinder2/sheet/e2e/test-pathfinder2-builder-e2e.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.3",
    "@tiptap/extension-image": "^3.23.4",
    "@tiptap/extension-link": "^3.23.4",
    "@tiptap/extension-placeholder": "^3.23.4",
    "@tiptap/pm": "^3.23.4",
    "@tiptap/react": "^3.23.4",
    "@tiptap/starter-kit": "^3.23.4",
    "@vercel/speed-insights": "^2.0.0",
    "framer-motion": "^12.38.0",
    "next": "^16.2.4",
    "playwright": "^1.62.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.184.0",
    "tldraw": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "25.6.1",
    "@types/react": "^19.2.14",
    "@types/three": "^0.184.1",
    "tsx": "^4.22.4",
    "typescript": "6.0.3"
  },
  "overrides": {
    "@tiptap/extension-highlight": "3.23.4"
  }
}
